# 高德地图 JS API 2.0（密钥来自 docs/gd-js20.md，请复制到 .env.local，勿提交）
# 注意：JS API 2.0 的 securityJsCode 前端可见，仅本地演示可接受；生产建议改用服务端代理。
VITE_AMAP_KEY=your_amap_key
VITE_AMAP_SECURITY=your_amap_security_code

# 后端地址（dev 代理目标）；默认 http://localhost:8000
VITE_API_TARGET=http://localhost:8000

# 离线回放：置 1 时使用 src/mock 真实响应 fixture，不调用后端
VITE_MOCK=0

# 语音播报走后端 /api/v1/tts/synthesize，前端不需要填写语音 Key。
# 后端默认复用 QWEN_API_KEY，可在项目根目录 .env.example 查看 Qwen-TTS 可选字段。

# 演示节奏（需求17）：留空用默认值。汇报现场可调慢让领导看清。
# 打字机每字间隔（ms），默认 28
VITE_DEMO_TYPING_MS=28
# 第一幕打字完成后的停留（ms），默认 750
VITE_DEMO_ACT_DWELL_FIRST_MS=750
# 第二幕及之后每幕停留（ms），默认 2000
VITE_DEMO_ACT_DWELL_AFTER_MS=2000
# 证据核验 / 归因分析等地图重点幕额外停留（ms），默认 2000
VITE_DEMO_ACT_DWELL_MAP_EXTRA_MS=2000
