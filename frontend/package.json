{
  "name": "traffic-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "交通智能体·排队溢出九幕演示前端（Vue3 + TS + Vite，前后端分离 SPA）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "pinia": "^2.2.6",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@amap/amap-jsapi-types": "^0.0.15",
    "@playwright/test": "^1.49.1",
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.10"
  }
}
