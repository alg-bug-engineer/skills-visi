# Qwen API
QWEN_API_KEY=your-api-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_S=360

# Qwen-TTS Realtime（语音播报）
# 当 QWEN_BASE_URL 是 DashScope 时，TTS 默认复用 QWEN_API_KEY；
# 如果 LLM 使用其他 MaaS/供应商，请填写 DASHSCOPE_API_KEY。
DASHSCOPE_API_KEY=
QWEN_TTS_MODEL=qwen3-tts-flash-realtime
QWEN_TTS_VOICE=Cherry
QWEN_TTS_MODE=commit
QWEN_TTS_SAMPLE_RATE=24000
# TTS Realtime WS 默认留空 workspace（按 Key 默认空间鉴权）。
# 切勿填 LLM 的 workspace，否则 TTS WS 可能报 Workspace access denied。
QWEN_TTS_WORKSPACE_ID=
TTS_ENABLED=true

# 测试模式：true 时不调用真实 API，使用规则化 mock 响应
LLM_MOCK=false

# 日志
LOG_LEVEL=INFO

# 案例库路径（相对项目根目录）
CASE_LIBRARY_PATH=data/knowledge_qa.jsonl

# 数据真源（需求2）
# 生产环境保持 false；仅本地联调或剧本演示时显式开启
# false 时：路口注册表、诊断/配时 fixture 均不可用，须 PG_DSN 或 task 注入
ALLOW_DEMO_FALLBACK=false
PG_DSN=
MYSQL_DSN=
PG_SCHEMA=road6
PG_FLOW_SCHEMA=xianchang
PG_DIM_INTER_TABLE=dim_inter_info
PG_CHANNEL_TABLE=dwd_tfc_rltn_wide_inter_ft_link

# 单点优化器（signal_optimization_engine）源码路径
# 默认会尝试 ../古特代码仓库/signal_optimization_engine/src
SIGNAL_OPT_ENGINE_SRC=

# 方案反馈日志（接受/拒绝）
FEEDBACK_LOG_PATH=data/plan_feedback.jsonl

# 用户经验沉淀（认知/诊断/方案）
USER_EXPERIENCE_PATH=data/user_experience.jsonl
